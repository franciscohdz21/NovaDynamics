# Port the HTTP server listens on
PORT=3000

# 32-byte key (64 hex chars) used for AES-256-GCM encryption of audit log entries.
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_LOG_ENCRYPTION_KEY=

# Fraction (0-1) of mock AI calls that should randomly fail, for demoing the circuit breaker.
MOCK_AI_FAILURE_RATE=0

# Consecutive mock AI failures required to trip the circuit breaker open.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# Milliseconds the circuit breaker stays open before allowing a half-open trial call.
CIRCUIT_BREAKER_COOLDOWN_MS=30000
